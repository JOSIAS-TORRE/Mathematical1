Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", 
   RowBox[{
    RowBox[{"2.", " ", "Crear", " ", "topolog\[IAcute]a", " ", "1"}], "->", 
    RowBox[{"2", " ", "a", " ", "nivel", " ", "\[AAcute]rbol"}]}], "*)"}], 
  RowBox[{
   RowBox[{
    RowBox[{"topAWW", "=", 
     RowBox[{"CreateTopologies", "[", 
      RowBox[{"0", ",", 
       RowBox[{"1", "->", "2"}]}], "]"}]}], ";"}], "\n", 
   "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{
     RowBox[{
      RowBox[{"V", "[", "1", "]"}], "=", 
      RowBox[{"Fot\[OAcute]n", " ", 
       RowBox[{"(", "A", ")"}]}]}], ",", 
     RowBox[{
      RowBox[{
       RowBox[{
        RowBox[{"V", "[", "3", "]"}], " ", "y"}], "-", 
       RowBox[{"V", "[", "3", "]"}]}], "=", 
      RowBox[{
       RowBox[{"Bosones", " ", "W"}], "+", 
       RowBox[{"y", " ", "W"}], "-"}]}]}], "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"diagramasAWW", "=", 
     RowBox[{"InsertFields", "[", 
      RowBox[{"topAWW", ",", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"V", "[", "1", "]"}], "}"}], "->", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"V", "[", "3", "]"}], ",", 
          RowBox[{"-", 
           RowBox[{"V", "[", "3", "]"}]}]}], "}"}]}], ",", 
       RowBox[{"Model", "->", "\"\<Grafica_Gauge\>\""}], ",", 
       RowBox[{"GenericModel", "->", "\"\<Grafica_Gauge\>\""}]}], "]"}]}], 
    ";"}], "\n", "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{"3.", " ", "Dibujar", " ", "el", " ", "diagrama", " ", "limpio"}],
     "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"Paint", "[", 
     RowBox[{"diagramasAWW", ",", 
      RowBox[{"PaintLevel", "->", 
       RowBox[{"{", "Classes", "}"}]}], ",", 
      RowBox[{"ColumnsXRows", "->", 
       RowBox[{"{", 
        RowBox[{"1", ",", "1"}], "}"}]}], ",", 
      RowBox[{"SheetHeader", "->", "False"}], ",", 
      RowBox[{"Numbering", "->", "None"}]}], "]"}], ";"}], "\n", 
   "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{
    "4.", " ", "Extraer", " ", "el", " ", "acoplamiento", " ", "de", " ", 
     "M$CouplingMatrices", " ", "y", " ", "armar", " ", "la", " ", 
     "estructura", " ", "de", " ", "Lorentz", " ", "VVV"}], "*)"}], 
   "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"acoplamientoAWW", "=", 
     RowBox[{"First", "[", 
      RowBox[{"Cases", "[", 
       RowBox[{"M$CouplingMatrices", ",", 
        RowBox[{
         RowBox[{"(", 
          RowBox[{
           RowBox[{"C", "[", 
            RowBox[{"OrderlessPatternSequence", "[", 
             RowBox[{
              RowBox[{"V", "[", "1", "]"}], ",", 
              RowBox[{"V", "[", "3", "]"}], ",", 
              RowBox[{"-", 
               RowBox[{"V", "[", "3", "]"}]}]}], "]"}], "]"}], "==", "val_"}],
           ")"}], ":>", 
         RowBox[{"val", "[", 
          RowBox[{"[", 
           RowBox[{"1", ",", "1"}], "]"}], "]"}]}]}], "]"}], "]"}]}], ";"}], 
   "\n", "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{
    "Estructura", " ", "cinem\[AAcute]tica", " ", "de", " ", "Lorentz", " ", 
     "para", " ", "3", " ", "bosones", " ", "vectoriales", " ", 
     RowBox[{"(", 
      RowBox[{
       RowBox[{"momentos", " ", "entrantes", " ", "k1"}], ",", "k2", ",", 
       "k3"}], ")"}]}], "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"tensorLorentzVVV", "=", 
     RowBox[{"(", 
      RowBox[{
       RowBox[{
        RowBox[{"Subscript", "[", 
         RowBox[{"g", ",", "\[Mu]\[Nu]"}], "]"}], " ", 
        RowBox[{
         RowBox[{"(", 
          RowBox[{
           RowBox[{"Subscript", "[", 
            RowBox[{"k", ",", "1"}], "]"}], "-", 
           RowBox[{"Subscript", "[", 
            RowBox[{"k", ",", "2"}], "]"}]}], ")"}], "[", "\[Rho]", "]"}]}], 
       "+", 
       RowBox[{
        RowBox[{"Subscript", "[", 
         RowBox[{"g", ",", "\[Nu]\[Rho]"}], "]"}], " ", 
        RowBox[{
         RowBox[{"(", 
          RowBox[{
           RowBox[{"Subscript", "[", 
            RowBox[{"k", ",", "2"}], "]"}], "-", 
           RowBox[{"Subscript", "[", 
            RowBox[{"k", ",", "3"}], "]"}]}], ")"}], "[", "\[Mu]", "]"}]}], 
       "+", 
       RowBox[{
        RowBox[{"Subscript", "[", 
         RowBox[{"g", ",", "\[Rho]\[Mu]"}], "]"}], " ", 
        RowBox[{
         RowBox[{"(", 
          RowBox[{
           RowBox[{"Subscript", "[", 
            RowBox[{"k", ",", "3"}], "]"}], "-", 
           RowBox[{"Subscript", "[", 
            RowBox[{"k", ",", "1"}], "]"}]}], ")"}], "[", "\[Nu]", "]"}]}]}], 
      ")"}]}], ";"}], "\[IndentingNewLine]", "\n", 
   RowBox[{
    RowBox[{"verticeAWW", "=", 
     RowBox[{"Simplify", "[", 
      RowBox[{
       RowBox[{"acoplamientoAWW", "*", "tensorLorentzVVV"}], "/.", " ", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"EL", "->", "e"}], ",", 
         RowBox[{"gw", "->", 
          RowBox[{"Subscript", "[", 
           RowBox[{"g", ",", "W"}], "]"}]}], ",", 
         RowBox[{"sw", "->", 
          RowBox[{"Subscript", "[", 
           RowBox[{"s", ",", "w"}], "]"}]}]}], "}"}]}], "]"}]}], ";"}], 
   "\[IndentingNewLine]", "\n", 
   RowBox[{"Style", "[", 
    RowBox[{
     RowBox[{"TraditionalForm", "[", "verticeAWW", "]"}], ",", "18", ",", 
     RowBox[{"FontFamily", "->", "\"\<CMU Serif\>\""}]}], "]"}]}]}]], "Input",\

 CellChangeTimes->{3.999889721526194*^9},
 CellLabel->"In[6]:=",ExpressionUUID->"e22ca47c-4358-485f-bcb4-251f5f3dc34a"],

